        <attrs>
         <specsEditor>
          <val>
           <![CDATA[<specs>
  <ports>
    <in type="PEG"/>
    <out type="IMAGE"/>
  </ports>
  <attributes>
    <attr type="BOOL"   name="invert"                    value="false" tooltip="Flip slider direction."/>
    <attr type="BOOL"   name="horizontal"                value="true" tooltip="Horizontal slider layout."/>
    <attr type="BOOL"   name="label_screen_space"        value="false" tooltip="Check this options for the label size to be in screen space."/>
    <attr type="BOOL"   name="interpolate_slider"         value="false" tooltip="Allow fractional interpolation between slider frames."/>
    <attr type="STRING" name="label"                     value="mc_CH_a_turn" tooltip="Master Controller label."/>
    <attr type="STRING" name="label_font"                value="Arial" tooltip="Label font."/>
    <attr type="DOUBLE" name="widget_size"               value="0.25" tooltip="Radius of the slider handle."/>
